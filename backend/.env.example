APP_ENV=development
PORT=8080

# Supabase -> Connect -> Transaction pooler (port 6543). The direct host is
# IPv6-only and some networks drop port 5432; the backend is set up to work
# through the transaction pooler. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Used to fetch the JWKS that verifies user access tokens.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only for projects still on the legacy HS256 JWT secret; leave empty otherwise.
SUPABASE_JWT_SECRET=

# Sandbox and production share the base URL and client ID; only the secret changes.
# In production these come from the secret store, never from a file.
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
# Empty disables webhook signature checks (allowed in development only).
BITNOB_WEBHOOK_SECRET=

# Secret key for hashing BVNs before they are stored (any long random string).
# Changing it later breaks duplicate-BVN detection for existing users.
KYC_HASH_KEY=

# Our margin on swaps in basis points of the amount received (50 = 0.5%).
# A starting proposal from the spec, not a settled price.
SWAP_FEE_BPS=50

# Our fee on payouts in basis points of the amount sent (100 = 1%). Also a
# starting proposal; price per corridor once Bitnob's costs are known.
PAYOUT_FEE_BPS=100

# Fiat payout currencies offered. Anything else Bitnob supports is hidden.
PAYOUT_CURRENCIES=NGN,GHS,KES,RWF,XOF,XAF,UGX,GMD

# Closed beta: only phone numbers in the beta_invites table can sign up.
# Add one with: make invite PHONE=2348012345678
BETA_INVITE_ONLY=true

# Our own outflow limits, in whole naira. Placeholders; set what you want.
LIMIT_DAILY_NGN=50000
LIMIT_SINGLE_NGN=50000
LIMIT_MAX_SENDS_PER_DAY=20
# For this long after an account is first funded, payouts and crypto sends
# together are capped at the lower daily amount.
LIMIT_NEW_ACCOUNT_HOLD_HOURS=72
LIMIT_NEW_ACCOUNT_DAILY_NGN=10000

# Virtual card charges in micro-dollars (1000000 = $1): what we charge the user
# and what Bitnob takes. The sandbox needed $2 on top of the load to issue a
# card; the funding figures are guesses until Bitnob confirms its fees.
CARD_CREATION_FEE_MICRO_USD=2000000
CARD_CREATION_COST_MICRO_USD=2000000
CARD_FUND_FEE_MICRO_USD=500000
CARD_FUND_COST_MICRO_USD=0
