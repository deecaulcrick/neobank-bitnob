APP_ENV=development
PORT=8080

# Supabase -> Connect -> Transaction pooler (port 6543). The direct host is
# IPv6-only and some networks drop port 5432; the backend is set up to work
# through the transaction pooler. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Used to fetch the JWKS that verifies user access tokens.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only for projects still on the legacy HS256 JWT secret; leave empty otherwise.
SUPABASE_JWT_SECRET=

# Sandbox and production share the base URL and client ID; only the secret changes.
# In production these come from the secret store, never from a file.
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
# Empty disables webhook signature checks (allowed in development only).
BITNOB_WEBHOOK_SECRET=
